<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"> <!-- Добавили пространство имен app -->

    <SwitchPreferenceCompat
        android:key="disable_engine_sound"
        android:title="Отключить звук мотора"
        android:defaultValue="false" />

    <SwitchPreferenceCompat
        android:key="ignore_axis_x"
        android:title="Игнорировать ось X (влево / вправо)"
        android:defaultValue="false" />

    <SwitchPreferenceCompat
        android:key="ignore_axis_y"
        android:title="Игнорировать ось Y (вперед / назад)"
        android:defaultValue="false" />

    <SwitchPreferenceCompat
        android:key="ignore_distance_1"
        android:title="Игнорировать distance 1"
        android:defaultValue="false" />

    <SwitchPreferenceCompat
        android:key="ignore_distance_2"
        android:title="Игнорировать distance 2"
        android:defaultValue="false" />

    <androidx.preference.EditTextPreference
        android:key="speed_slope_coef"
        android:title="Ускорение / рост оборотов (k в y=kx+b)"
        android:defaultValue="1.0"
        android:inputType="numberDecimal|numberSigned"
        app:useSimpleSummaryProvider="true" /> <!-- Эта строка включает автоотображение значения -->

    <androidx.preference.EditTextPreference
        android:key="speed_intercept_coef"
        android:title="Обороты холостого хода (b в y=kx+b)"
        android:defaultValue="1.0"
        android:inputType="numberDecimal|numberSigned"
        app:useSimpleSummaryProvider="true" /> <!-- Эта строка включает автоотображение значения -->

    <PreferenceCategory
        android:title="Калибровка джойстика">
        <Preference
            android:key="pref_open_calibration"
            android:title="Мастер балансировки джойстика"
            android:summary="Пошаговая настройка нейтрали и 4 направлений" />
        <Preference
            android:key="pref_calibration_status"
            android:title="Текущая калибровка"
            android:summary="Не откалиброван" />
    </PreferenceCategory>

</PreferenceScreen>