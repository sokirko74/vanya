<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"> <!-- Добавили пространство имен app -->

    <SwitchPreferenceCompat
        android:key="disable_engine_sound"
        android:title="Отключить звук мотора"
        android:defaultValue="false" />

    <SwitchPreferenceCompat
        android:key="ignore_speed_1"
        android:title="Игнорировать speed 1"
        android:defaultValue="false" />

    <SwitchPreferenceCompat
        android:key="ignore_speed_2"
        android:title="Игнорировать speed 2"
        android:defaultValue="false" />

    <SwitchPreferenceCompat
        android:key="ignore_distance_1"
        android:title="Игнорировать distance 1"
        android:defaultValue="false" />

    <SwitchPreferenceCompat
        android:key="ignore_distance_2"
        android:title="Игнорировать distance 2"
        android:defaultValue="false" />

    <androidx.preference.EditTextPreference
        android:key="speed_slope_coef"
        android:title="Угловой коэффициент скорости в y=kx+b"
        android:defaultValue="1.0"
        android:inputType="numberDecimal|numberSigned"
        app:useSimpleSummaryProvider="true" /> <!-- Эта строка включает автоотображение значения -->

    <androidx.preference.EditTextPreference
        android:key="speed_intercept_coef"
        android:title="Свободный коэф. в y=kx+b"
        android:defaultValue="1.0"
        android:inputType="numberDecimal|numberSigned"
        app:useSimpleSummaryProvider="true" /> <!-- Эта строка включает автоотображение значения -->

</PreferenceScreen>